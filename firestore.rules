rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Projects collection
    match /projects/{projectId} {
      // Anyone can read a single project document if it is marked as public
      // Or if the authenticated user is the owner
      allow get: if resource.data.isPublic == true ||
                    (request.auth != null && resource.data.ownerId == request.auth.uid);

      // List queries: authenticated owners can list their projects,
      // or clients can query public projects by shareId
      allow list: if (request.auth != null && resource.data.ownerId == request.auth.uid) ||
                     (resource.data.isPublic == true);

      // Create: user must be authenticated, ownerId must match user UID,
      // required fields present, and title/shareId size constraints respected
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() <= 200 &&
                       request.resource.data.templateType is string &&
                       request.resource.data.templateType.size() <= 64 &&
                       request.resource.data.isPublic is bool &&
                       request.resource.data.shareId is string &&
                       request.resource.data.shareId.size() <= 64;

      // Update: only the owner can update their project, ownerId must remain immutable
      allow update: if request.auth != null &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() <= 200 &&
                       request.resource.data.isPublic is bool &&
                       request.resource.data.shareId is string &&
                       request.resource.data.shareId.size() <= 64;

      // Delete: only the owner can delete
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
