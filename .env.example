# ==============================================================================
# TEACH ARAB - ENVIRONMENT VARIABLES (.env.example)
# Salin berkas ini menjadi .env di root proyek Anda: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (Server-Side Only - JANGAN PERNAH BERI AWALAN VITE_)
# Digunakan oleh endpoint Express /api/generate untuk fitur Bantuan AI Guru
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# URL Deployment Aplikasi (Opsional)
APP_URL="https://your-teacharab.vercel.app"

# ------------------------------------------------------------------------------
# 2. FIREBASE CONFIGURATION (Vite Client Env)
# Dapatkan dari: Firebase Console > Project Settings > General > Your apps > Web app
# Digunakan untuk Otentikasi Guru (Google Sign-In) dan sinkronisasi Cloud Firestore
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
# (Opsional) Kosongkan jika menggunakan database Firestore default "(default)"
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 3. CLOUDINARY CONFIGURATION (Unsigned Upload untuk Media Publik Siswa)
# Dapatkan dari Cloudinary Console:
# 1. Cloud Name dari dashboard utama
# 2. Upload Preset dari Settings > Upload > Upload presets > Add preset (Signing Mode: Unsigned)
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
